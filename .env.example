# ==============================================================================
# LOOPWISE Environment Variables
# Copy to .env.local for local development
# ==============================================================================

# Application URL
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Database (PostgreSQL via Prisma / Neon)
DATABASE_URL="postgresql://user:password@localhost:5432/loopwise?schema=public"

# Supabase Auth & Storage
NEXT_PUBLIC_SUPABASE_URL="https://your-project.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="your-anon-key"
SUPABASE_SERVICE_ROLE_KEY="your-service-role-key"

# Auth.js (NextAuth v5 compatibility)
AUTH_SECRET="development-auth-secret-change-in-production-min-32-chars"
AUTH_GOOGLE_ID=""
AUTH_GOOGLE_SECRET=""

# Email (Resend in production, Mailpit/console in dev)
RESEND_API_KEY=""
EMAIL_FROM="Loopwise <notifications@loopwise.ai>"

# Stripe (Test Mode)
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""
STRIPE_CONNECT_CLIENT_ID=""
STRIPE_PRICE_MONTHLY=""
STRIPE_PRICE_YEARLY=""

# Groq API (AI workflow mapping, agent validation, ROI estimates)
GROQ_API_KEY=""
AI_MODEL="llama-3.3-70b-versatile"

# File Storage (local | s3)
STORAGE_DRIVER="local"
S3_BUCKET="loopwise-uploads"
S3_REGION="us-east-1"
S3_ACCESS_KEY_ID=""
S3_SECRET_ACCESS_KEY=""
S3_ENDPOINT=""
